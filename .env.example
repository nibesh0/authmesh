# ---------------------------------------------------------------------------
# Local development configuration. Copy to .env before `make dev-up`:
#
#     cp .env.example .env
#
# The values below are DEVELOPMENT ONLY and are committed on purpose so the
# stack starts with one command. Generate real secrets for anything else:
#
#   JWT_SECRET            openssl rand -base64 48
#   TOTP_ENCRYPTION_KEY   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   RECOVERY_CODE_PEPPER  openssl rand -hex 32
#
# In Kubernetes these three come from a Secret, not from this file.
# ---------------------------------------------------------------------------

ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_FORMAT=json
VERSION=0.1.0

# --- secrets (dev only) ----------------------------------------------------
JWT_SECRET=dev-only-jwt-secret-change-me-0123456789abcdef
TOTP_ENCRYPTION_KEY=ZmRldi1vbmx5LWtleS1kby1ub3QtdXNlLWluLXByb2Q=
RECOVERY_CODE_PEPPER=dev-only-recovery-pepper-change-me

# --- infrastructure --------------------------------------------------------
MONGO_URI=mongodb://mongo:27017
MONGO_DATABASE=authmesh
REDIS_URL=redis://redis:6379/0

# --- service discovery -----------------------------------------------------
AUTH_SERVICE_TARGET=auth-service:50051
USER_SERVICE_TARGET=user-service:50052

# --- token lifetimes -------------------------------------------------------
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=1209600
SESSION_ABSOLUTE_TTL_SECONDS=2592000
MFA_CHALLENGE_TTL_SECONDS=300

# --- password policy -------------------------------------------------------
# 12 rounds is roughly 250ms on a modern core: expensive for an attacker,
# tolerable for a login. Lower it only for tests.
BCRYPT_ROUNDS=12
PASSWORD_MIN_LENGTH=12

# --- abuse controls --------------------------------------------------------
RATE_LIMIT_ENABLED=true
# Raised from the production default of 20 because every local request arrives
# from the same Docker bridge address, and the smoke test would otherwise trip
# the per-IP limit partway through. The per-account limit below is left at its
# real value and is what the smoke test exercises.
LOGIN_RATE_LIMIT_PER_IP=200
LOGIN_RATE_LIMIT_PER_ACCOUNT=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
# Same reasoning: the production default is 5 per 5 minutes per address, which a
# repeated local smoke run would exhaust.
REGISTER_RATE_LIMIT_PER_IP=100
LOCKOUT_ENABLED=true
LOCKOUT_THRESHOLD=5
LOCKOUT_DURATION_SECONDS=900

# --- gateway ---------------------------------------------------------------
HTTP_PORT=8080
DOCS_ENABLED=true
# 0 = ignore X-Forwarded-For. Set to the number of proxies in front of the
# gateway (1 behind a single ingress) or per-IP limits can be spoofed.
TRUSTED_PROXY_HOPS=0
